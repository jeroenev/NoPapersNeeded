#!/bin/sh
set -eu

message_file=$1
source=${2:-}

case "$source" in
    merge|squash)
        exit 0
        ;;
esac

first_line=
IFS= read -r first_line < "$message_file" || true
case "$first_line" in
    \[*\]*)
        exit 0
        ;;
esac

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
if [ -z "$branch" ]; then
    exit 0
fi

temporary_file="$message_file.npn.$$"
trap 'rm -f "$temporary_file"' EXIT HUP INT TERM
{
    printf '[%s] ' "$branch"
    cat "$message_file"
} > "$temporary_file"
mv "$temporary_file" "$message_file"
trap - EXIT HUP INT TERM

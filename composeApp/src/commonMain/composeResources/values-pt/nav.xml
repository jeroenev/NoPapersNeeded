<resources>
    <!-- Compact bottom bar item opening the sheet with the destinations the bar cannot hold. -->
    <string name="nav_more">Mais</string>
    <string name="nav_more_destinations">Mais destinos</string>
    <!-- Navigation item for the assistant, with its Chat and Bulk edit modes. -->
    <string name="nav_assistant">Assistente</string>

    <!-- Read out for the Activity item's running indicator, whose spinning ring means nothing on its own. -->
    <plurals name="nav_queue_pending">
        <item quantity="one">%1$d documento ainda em processamento</item>
        <item quantity="other">%1$d documentos ainda em processamento</item>
    </plurals>

    <!-- Same item, when a background bulk edit has finished and its suggestions wait to be reviewed. -->
    <plurals name="nav_queue_review">
        <item quantity="one">Sugestões prontas para %1$d edição em massa</item>
        <item quantity="other">Sugestões prontas para %1$d edições em massa</item>
    </plurals>

    <!-- Same item, when background work stopped and waits for a retry. -->
    <plurals name="nav_queue_failed">
        <item quantity="one">%1$d item em Atividade precisa de atenção</item>
        <item quantity="other">%1$d itens em Atividade precisam de atenção</item>
    </plurals>


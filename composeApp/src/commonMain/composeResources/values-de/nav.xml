<resources>
    <!-- Compact bottom bar item opening the sheet with the destinations the bar cannot hold. -->
    <string name="nav_more">Mehr</string>
    <string name="nav_more_destinations">Weitere Bereiche</string>
    <!-- Navigation item for the assistant, with its Chat and Bulk edit modes. -->
    <string name="nav_assistant">Assistent</string>

    <!-- Read out for the Activity item's running indicator, whose spinning ring means nothing on its own. -->
    <plurals name="nav_queue_pending">
        <item quantity="one">%1$d Dokument wird noch verarbeitet</item>
        <item quantity="other">%1$d Dokumente werden noch verarbeitet</item>
    </plurals>

    <!-- Same item, when a background bulk edit has finished and its suggestions wait to be reviewed. -->
    <plurals name="nav_queue_review">
        <item quantity="one">Vorschläge für %1$d Massenbearbeitung bereit</item>
        <item quantity="other">Vorschläge für %1$d Massenbearbeitungen bereit</item>
    </plurals>

    <!-- Same item, when background work stopped and waits for a retry. -->
    <plurals name="nav_queue_failed">
        <item quantity="one">%1$d Eintrag unter „Aktivität“ braucht Aufmerksamkeit</item>
        <item quantity="other">%1$d Einträge unter „Aktivität“ brauchen Aufmerksamkeit</item>
    </plurals>


<resources>
    <!-- Compact bottom bar item opening the sheet with the destinations the bar cannot hold. -->
    <string name="nav_more">Más</string>
    <string name="nav_more_destinations">Más destinos</string>
    <!-- Navigation item for the assistant, with its Chat and Bulk edit modes. -->
    <string name="nav_assistant">Asistente</string>

    <!-- Read out for the Activity item's running indicator, whose spinning ring means nothing on its own. -->
    <plurals name="nav_queue_pending">
        <item quantity="one">%1$d documento aún se está procesando</item>
        <item quantity="other">%1$d documentos aún se están procesando</item>
    </plurals>

    <!-- Same item, when a background bulk edit has finished and its suggestions wait to be reviewed. -->
    <plurals name="nav_queue_review">
        <item quantity="one">Sugerencias listas para %1$d edición masiva</item>
        <item quantity="other">Sugerencias listas para %1$d ediciones masivas</item>
    </plurals>

    <!-- Same item, when background work stopped and waits for a retry. -->
    <plurals name="nav_queue_failed">
        <item quantity="one">%1$d elemento de Actividad requiere atención</item>
        <item quantity="other">%1$d elementos de Actividad requieren atención</item>
    </plurals>


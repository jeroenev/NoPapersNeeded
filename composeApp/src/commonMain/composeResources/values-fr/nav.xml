<resources>
    <!-- Compact bottom bar item opening the sheet with the destinations the bar cannot hold. -->
    <string name="nav_more">Plus</string>
    <string name="nav_more_destinations">Autres destinations</string>
    <!-- Navigation item for the assistant, with its Chat and Bulk edit modes. -->
    <string name="nav_assistant">Assistant</string>

    <!-- Read out for the Activity item's running indicator, whose spinning ring means nothing on its own. -->
    <plurals name="nav_queue_pending">
        <item quantity="one">%1$d document en cours de traitement</item>
        <item quantity="other">%1$d documents en cours de traitement</item>
    </plurals>

    <!-- Same item, when a background bulk edit has finished and its suggestions wait to be reviewed. -->
    <plurals name="nav_queue_review">
        <item quantity="one">Suggestions prêtes pour %1$d modification groupée</item>
        <item quantity="other">Suggestions prêtes pour %1$d modifications groupées</item>
    </plurals>

    <!-- Same item, when background work stopped and waits for a retry. -->
    <plurals name="nav_queue_failed">
        <item quantity="one">%1$d élément d’Activité demande votre attention</item>
        <item quantity="other">%1$d éléments d’Activité demandent votre attention</item>
    </plurals>


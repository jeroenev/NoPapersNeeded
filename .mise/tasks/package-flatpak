#!/usr/bin/env bash
#MISE description="Build a Linux .flatpak bundle (needs flatpak-builder; builds Tesseract on the first run)"
set -euo pipefail

# Repackages the jpackage app image with flatpak-builder (desktopApp/flatpak/), then exports a
# single-file bundle. Missing runtimes are installed from the Flathub remote.

cd "$(git rev-parse --show-toplevel)"

app_id=io.github.jeroenev.NoPapersNeeded
manifest="desktopApp/flatpak/$app_id.yml"
out=desktopApp/build/flatpak
# flatpak-builder's state, build dir and repo hold sandbox roots with symlinks into the host's /run,
# which send file walkers such as Spotless into unreadable system directories, so they live
# outside the project. The state dir keeps the Tesseract build between runs.
work="${XDG_CACHE_HOME:-$HOME/.cache}/no-papers-needed/flatpak"
version=$(sed -n 's/^npn\.version=//p' gradle.properties)
bundle="$out/no-papers-needed-$version-x86_64.flatpak"

if command -v flatpak-builder >/dev/null; then
    builder=(flatpak-builder)
elif flatpak info org.flatpak.Builder >/dev/null 2>&1; then
    builder=(flatpak run --command=flatpak-builder org.flatpak.Builder)
else
    echo "error: needs flatpak-builder (distro package, or 'flatpak install flathub org.flatpak.Builder')" >&2
    exit 1
fi

# flatpak-builder needs the runtime and SDK in the same installation: the one that already has
# the SDK, otherwise per user if Flathub is configured there, otherwise system-wide.
runtime_version=$(sed -n 's/^runtime-version: "\(.*\)"$/\1/p' "$manifest")
if flatpak info --system "org.freedesktop.Sdk//$runtime_version" >/dev/null 2>&1; then
    installation=--system
elif flatpak info --user "org.freedesktop.Sdk//$runtime_version" >/dev/null 2>&1; then
    installation=--user
elif flatpak remotes --user --columns=name | grep -qx flathub; then
    installation=--user
else
    installation=--system
fi
for runtime in org.freedesktop.Platform org.freedesktop.Sdk; do
    flatpak info "$installation" "$runtime//$runtime_version" >/dev/null 2>&1 ||
        flatpak install --noninteractive "$installation" flathub "$runtime//$runtime_version"
done

./gradlew :desktopApp:stageLinuxBundle
mkdir -p "$out"

"${builder[@]}" \
    --force-clean \
    --disable-rofiles-fuse \
    --state-dir="$work/state" \
    --repo="$work/repo" \
    "$work/build-dir" \
    "$manifest"

# --runtime-repo lets `flatpak install` fetch the runtime from Flathub when the user lacks it.
flatpak build-bundle \
    --runtime-repo=https://dl.flathub.org/repo/flathub.flatpakrepo \
    "$work/repo" "$bundle" "$app_id"

echo "Flatpak bundle written: $bundle"
